{
  "name": "chingu-care-ai-fire-tv",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-tvos/config-tv": "^0.1.7",
    "expo": "~58.0.17",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "prebuild": "EXPO_TV=1 expo prebuild --clean --platform android",
    "android": "EXPO_TV=1 expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --test kit/test/*.test.ts && cd hub && .venv/bin/python -m pytest -q",
    "demo": "./run-demo.sh"
  },
  "private": true,
  "description": "Chingu Care AI on Fire TV: the parent's TV becomes the care hub.",
